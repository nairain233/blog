---
import { Icon } from "astro-icon/components";
import matter from "gray-matter";
import { marked } from "marked";
import { siteConfig } from "@/config";
import memosRaw from "@/data/memos.md?raw";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 检查动态页面是否启用
if (!siteConfig.pages.memos) {
	return Astro.redirect("/404/");
}

type MemoItem = {
	date?: string;
	content?: string;
	tags?: string[];
};

const { data } = matter(memosRaw);
const frontmatterMemos = Array.isArray(data)
	? (data as MemoItem[])
	: Array.isArray((data as { memos?: unknown }).memos)
		? ((data as { memos: MemoItem[] }).memos ?? [])
		: [];

const memos = frontmatterMemos
	.filter((item) => item?.date && item?.content)
	.sort(
		(a, b) =>
			new Date(b.date as string).getTime() -
			new Date(a.date as string).getTime(),
	);

const formatter = new Intl.DateTimeFormat("zh-CN", {
	year: "numeric",
	month: "2-digit",
	day: "2-digit",
	hour: "2-digit",
	minute: "2-digit",
	hour12: false,
});
const formatDate = (date?: string | Date) =>
	date ? formatter.format(new Date(date)) : "";
const renderMarkdown = (content?: string) =>
	content ? (marked.parse(content) as string) : "";
---

<MainGridLayout title="动态" description="我的碎碎念、日常、灵感速记、自言自语">
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-9 py-6 relative w-full">
      <div class="mb-6">
        <div class="flex items-center gap-3 mb-3">
          <div
            class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70"
          >
            <Icon name="material-symbols:history-rounded" class="text-[1.5rem]" />
          </div>
          <div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">动态</div>
        </div>
        <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
          我的碎碎念、日常、灵感速记、自言自语
        </p>
      </div>

      {
        memos.length === 0 ? (
          <div class="text-sm text-neutral-500 dark:text-neutral-400">暂无动态内容</div>
        ) : (
          <div class="space-y-4">
            {memos.map((memo) => (
              <article class="rounded-xl border border-(--line-divider) p-4 bg-(--card-bg)">
                <header class="mb-2">
                  <p class="text-xs text-neutral-500 dark:text-neutral-400">
                    {formatDate(memo.date)}
                  </p>
                </header>
                <div
                  class="prose prose-sm dark:prose-invert max-w-none text-neutral-700 dark:text-neutral-200"
                  set:html={renderMarkdown(memo.content)}
                />
                {memo.tags && (
                  <div class="mt-3 flex flex-wrap gap-2">
                    {memo.tags.map((tag) => (
                      <span class="text-xs font-mono rounded bg-black/5 dark:bg-white/10 px-2 py-1">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </article>
            ))}
          </div>
        )
      }
    </div>
  </div>
</MainGridLayout>